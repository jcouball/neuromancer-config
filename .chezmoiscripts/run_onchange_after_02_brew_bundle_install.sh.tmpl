#!/bin/bash
#
# Install everything declared in .Brewfile.
#
# run_onchange_ keyed on the hash below, so editing .Brewfile re-applies it.
# The previous run_once_ version could never run a second time, which meant a
# package added to the Brewfile was never installed on an already-provisioned
# machine -- the repo said one thing and the Mac did another.
#
# after_ because this reads ~/.Brewfile, which chezmoi has to write first. The
# numeric prefix does not do that job -- it only orders the scripts relative to
# each other. What decides script-vs-file order is the target name, and
# ".chezmoiscripts/" (".c") sorts after ".Brewfile" (".B") but before
# ".tool-versions" (".t"). See "Two path traps" in the README.
#
# .Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}

set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"

# Install what is missing; do not upgrade what is already here.
#
# `brew bundle` upgrades outdated packages by default, which quietly turned
# every `chezmoi apply` into a bulk upgrade: editing one line of .Brewfile swept
# 19 unrelated packages forward, Docker Desktop and Chrome among them, while
# they were running. That is topgrade's job -- layer 5 owns upgrades, layer 1
# owns declaration -- and mixing the two means you can never apply a config
# change without also accepting whatever else happens to be outdated that day.
#
# To upgrade deliberately: `topgrade`, or `brew bundle --file="$HOME/.Brewfile"`
# with this variable unset.
export HOMEBREW_BUNDLE_NO_UPGRADE=1

BREWFILE="$HOME/.Brewfile"
[ -f "$BREWFILE" ] || { echo "❌ $BREWFILE not found." >&2; exit 1; }

# Mac App Store entries are handled separately from everything else.
#
# HOMEBREW_BUNDLE_MAS_SKIP is a space-separated list matched against an entry's
# name *or* its numeric id (Homebrew's bundle/skipper.rb handles the ids
# specifically because App Store names contain spaces). Deriving the ids from
# the Brewfile means there is no second list to drift out of sync.
mas_ids=$(awk -F'id:' '/^mas /{gsub(/[^0-9]/, "", $2); if ($2 != "") print $2}' "$BREWFILE" | tr '\n' ' ')
mas_count=$(printf '%s' "$mas_ids" | wc -w | tr -d ' ')

# Pass 1: taps, formulae, casks and VS Code extensions.
#
# Deliberately NOT fatal. `brew bundle` exits non-zero if any single entry
# fails, and chezmoi aborts the whole apply on a failing script -- so one bad
# cask used to take the entire rebuild down with it. Certification caught this
# with Zoom, whose installer package fails inside a VM: four entries out of 121
# failed, scripts 03, 04 and 05 never ran, and the machine ended up with every
# application and none of its runtimes. No Ruby, no Node, no Go, no Python, no
# Rust -- from a video conferencing app.
#
# A partial failure must not stop the layers below it. What is missing is not
# hidden: verify.sh runs `brew bundle check` and fails on anything absent, which
# is the right place to judge -- outcomes, not exit codes.
echo ">> Installing from Brewfile (excluding $mas_count Mac App Store apps)..."
if HOMEBREW_BUNDLE_MAS_SKIP="$mas_ids" brew bundle --file="$BREWFILE"; then
  echo ">> Brewfile installed."
else
  echo "!! Some Brewfile entries failed to install." >&2
  echo "!! Continuing: the runtimes below matter more than any single package," >&2
  echo "!! and aborting here would leave this machine with no Ruby or Node at all." >&2
  echo "!! Run 'certification/verify.sh' to see exactly what is missing." >&2
fi

# Pass 2: the Mac App Store apps.
#
# Split out because they are the one part that cannot always succeed: `mas`
# needs the App Store to be signed in, and inside an Apple Silicon VM that is
# impossible -- Virtualization.framework does not support App Store sign-in at
# all. A failure here must not abort provisioning, because everything that
# actually matters for development was already installed by pass 1.
if [ "${SKIP_MAS:-0}" = "1" ]; then
  echo ">> SKIP_MAS=1: skipping the $mas_count Mac App Store apps."
  exit 0
fi

if [ "$mas_count" -eq 0 ]; then
  exit 0
fi

echo ">> Installing $mas_count Mac App Store apps..."
if brew bundle --file="$BREWFILE"; then
  echo ">> Mac App Store apps installed."
else
  echo "!! Some Mac App Store apps did not install." >&2
  echo "!! Usually this means the App Store is not signed in. Sign in, then:" >&2
  echo "!!   brew bundle --file=\"\$HOME/.Brewfile\"" >&2
  echo "!! Inside a VM this is expected and cannot be fixed -- see the" >&2
  echo "!! Certification section of the README." >&2
fi
