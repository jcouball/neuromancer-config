#!/bin/bash
#
# Rosetta 2 -- needed by the handful of x86_64-only casks in .Brewfile.
#
# run_once_ rather than run_onchange_: Rosetta survives OS updates, so there is
# nothing to re-trigger on. The tradeoff is that if it ever *is* removed, this
# will not reinstall it -- see "Small gotchas" in the README.

set -euo pipefail

# `arch -x86_64`, not `pgrep oahd`. The daemon only runs while something is
# being translated, so pgrep reports "not installed" on a machine that simply
# has not run an Intel binary yet -- which reinstalls Rosetta needlessly, and
# made the verification call a working install a failure.
if arch -x86_64 /usr/bin/true 2>/dev/null; then
  echo ">> Rosetta 2 is already installed."
  exit 0
fi

# Needs root. Available unattended only with NOPASSWD or a cached credential;
# a bare `chezmoi apply` with no terminal cannot prompt.
if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
  echo "❌ Installing Rosetta needs sudo, and there is no terminal to prompt on." >&2
  echo "   Run 'sudo -v' first, then 'chezmoi apply' -- NOT 'sudo chezmoi apply'." >&2
  exit 1
fi

echo ">> Installing Rosetta 2..."

# --agree-to-license is required. Without it softwareupdate stops on an
# interactive licence prompt, which during an unattended provisioning run looks
# exactly like a hang: no output, no error.
sudo softwareupdate --install-rosetta --agree-to-license

arch -x86_64 /usr/bin/true 2>/dev/null || {
  echo "❌ Rosetta 2 install did not complete." >&2
  exit 1
}

echo ">> Rosetta 2 installed."
