#!/bin/bash
#
# Set this machine's name.
#
# The one piece of a rebuild that cannot be derived from the repo, because it is
# the answer to "which machine is this?" -- asked once by .chezmoi.toml.tmpl and
# recorded in chezmoi's config from then on.
#
# Three names, not one. macOS keeps them separately and they drift apart
# silently: ComputerName is what Finder and Sharing show, LocalHostName is the
# Bonjour name, and HostName is what the shell's `hostname` returns. On this
# machine HostName was simply never set, which nothing complains about until
# something reads it.
#
# run_onchange_ keyed on the name below, so changing it in chezmoi's config
# re-applies it rather than requiring you to remember the scutil incantation.
#
# computerName: {{ if hasKey . "computerName" }}{{ .computerName }}{{ else }}(unset){{ end }}

set -euo pipefail

# Never run under `sudo chezmoi apply`.
#
# The scripts that need root call `sudo` themselves, for the one command that
# needs it. Running chezmoi *as* root instead breaks things that quietly matter:
# Homebrew refuses to run as root at all, so the entire Brewfile step fails, and
# any file chezmoi writes risks landing in your home directory owned by root.
#
# The honest instruction is `sudo -v` first, then a normal `chezmoi apply` --
# which caches the credential so the sudo calls inside these scripts do not
# prompt.
if [ "$(id -u)" -eq 0 ]; then
  echo "❌ Do not run 'sudo chezmoi apply'." >&2
  echo "   Homebrew refuses to run as root, and chezmoi may write root-owned" >&2
  echo "   files into your home directory." >&2
  echo "   Instead:  sudo -v && chezmoi apply" >&2
  exit 1
fi

# chezmoi renders the template below before bash ever sees this file, so the
# braces are not shell syntax. Every other script here keeps its templating
# inside comments, which shellcheck ignores; this one cannot, because the value
# is the whole point of the script.
# hasKey, not a bare .computerName. A machine whose chezmoi config predates
# .chezmoi.toml.tmpl has no such key, and chezmoi renders templates with
# missingkey=error -- so this script did not merely skip, it failed to render at
# all, and took the whole apply down with it. A fresh install cannot reproduce
# that, because `chezmoi init` always writes the key. See "What certification
# cannot cover" in the README.
#
# shellcheck disable=SC1083
WANT={{ if hasKey . "computerName" }}{{ .computerName | quote }}{{ else }}""{{ end }}

[ -n "$WANT" ] || {
  echo ">> No computer name configured; skipping."
  echo ">> To set one on an existing machine: chezmoi init"
  exit 0
}

# LocalHostName cannot contain spaces or most punctuation -- macOS substitutes
# hyphens. Do the same substitution here rather than letting scutil reject it.
LOCAL_NAME="$(printf '%s' "$WANT" | tr ' ' '-' | tr -cd '[:alnum:]-')"

current="$(scutil --get ComputerName 2>/dev/null || echo '')"
if [ "$current" = "$WANT" ] \
   && [ "$(scutil --get HostName 2>/dev/null || echo '')" = "$WANT" ] \
   && [ "$(scutil --get LocalHostName 2>/dev/null || echo '')" = "$LOCAL_NAME" ]; then
  echo ">> Computer name already set to '$WANT'."
  exit 0
fi

# Needs root. Available unattended only with NOPASSWD or a cached credential.
if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
  echo "❌ Setting the computer name needs sudo, and there is no terminal to prompt on." >&2
  echo "   Run 'sudo -v' first, then 'chezmoi apply' -- NOT 'sudo chezmoi apply'." >&2
  exit 1
fi

echo ">> Setting computer name to '$WANT' (LocalHostName '$LOCAL_NAME')..."
sudo scutil --set ComputerName "$WANT"
sudo scutil --set HostName "$WANT"
sudo scutil --set LocalHostName "$LOCAL_NAME"

echo ">> ComputerName=$(scutil --get ComputerName) HostName=$(scutil --get HostName) LocalHostName=$(scutil --get LocalHostName)"
