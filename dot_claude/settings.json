{
  "env": {
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git commit --amend:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge *)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "jcouball-writing@jcouball": true,
    "jcouball-marketplace@jcouball": true,
    "jcouball-testing@jcouball": true,
    "jcouball-github@jcouball": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "jcouball": {
      "source": {
        "source": "github",
        "repo": "jcouball/agent-plugins"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
