{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code writes ~/.claude/settings.json itself: /model, /effort and /config
  change model, effortLevel and theme. Those three keys are copied from the
  file as it is, so chezmoi never reverts them or reports them as changed.
  Every other key comes from $managed. When there is no settings file yet, the
  three keys start from $defaults.

  Edit this file, not ~/.claude/settings.json: `chezmoi re-add` cannot update a
  modify_ template.
*/ -}}
{{- $managed := `
{
  "env": {
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "jcouball-writing@jcouball": true,
    "jcouball-github@jcouball": true,
    "jcouball-marketplace@jcouball": true,
    "jcouball-testing@jcouball": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "jcouball": {
      "source": {
        "source": "github",
        "repo": "jcouball/agent-plugins"
      }
    }
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "agentPushNotifEnabled": true
}
` | fromJson -}}
{{- $defaults := `
{
  "model": "opus[1m]",
  "effortLevel": "medium",
  "theme": "dark"
}
` | fromJson -}}
{{- $current := $defaults -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $current = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- range $key := list "model" "effortLevel" "theme" -}}
{{-   if hasKey $current $key -}}
{{-     $_ := set $managed $key (index $current $key) -}}
{{-   end -}}
{{- end -}}
{{ toPrettyJson $managed -}}
