Host sophon
  # The name sophon has on the tailnet, so this works away from the LAN. It
  # needs Tailscale running here and on sophon. Without it, from the LAN:
  # ssh -o HostName=192.168.0.199 sophon
  HostName sophon
  User james
  IdentityFile ~/.ssh/id_ed25519_sophon
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ForwardAgent no
  # sophon runs OpenSSH for Windows 9.5, which offers no post-quantum key
  # exchange. Accepted on the LAN and the tailnet; this silences only that
  # warning.
  WarnWeakCrypto no-pq-kex
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

Host rama
  User james
  IdentityFile ~/.ssh/id_ed25519_rama
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ForwardAgent no
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

Host neuromancer
  # The name Neuromancer has on the tailnet, so this works away from the LAN.
  # It needs Tailscale running here and on Neuromancer. Without it, from the
  # LAN: ssh -o HostName=neuromancer.local neuromancer
  HostName neuromancer
  User james
  IdentityFile ~/.ssh/id_ed25519_neuromancer
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ForwardAgent no
  # sshd on the Macs admits IPv4 addresses only (sshd-mac.conf). A tailnet name
  # has an IPv6 address too, and a .local name resolves to IPv6 link-local ones.
  AddressFamily inet
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

Host cortex
  # The name cortex has on the tailnet, so this works away from the LAN. It
  # needs Tailscale running here and on cortex. Without it, from the LAN:
  # ssh -o HostName=cortex.local cortex
  HostName cortex
  User james
  IdentityFile ~/.ssh/id_ed25519_cortex
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ForwardAgent no
  # As for neuromancer: IPv4 only. A tailnet name has an IPv6 address too.
  AddressFamily inet
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

Host 192.168.2.1
  User root
  IdentityFile ~/.ssh/id_rsa_proxmox_admin

Host 192.168.2.101
  User root
  IdentityFile ~/.ssh/id_rsa_cloudflared_admin

Host *
  ForwardAgent yes
  KeepAlive yes
  ServerAliveInterval 60
  StrictHostKeyChecking no
  CASignatureAlgorithms +ssh-rsa
  Protocol 2
  AddKeysToAgent yes
  UseKeychain yes
